# Copy to .env.local (gitignored) and fill in your CoinMarketCap API key.
# Never commit the real key.
#
# Official docs: https://coinmarketcap.com/api/documentation/pro-api-reference/cryptocurrency
# Header used by Frame: X-CMC_PRO_API_KEY

CMC_API_KEY=your_cmc_api_key_here

# Optional. Default is 300000 (5 minutes). Values under 60000 are clamped to 60s.
# CMC_POLL_INTERVAL_MS=300000

# Optional. Max ERC-20s quoted per poll (natives are always included). Default 40, max 200.
# CMC_MAX_TOKENS=40
